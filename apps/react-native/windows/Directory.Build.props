<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- DesktopBench: build against the Windows SDK installed on this machine (template defaults to 10.0.22621.0). -->
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- Ship the Windows App SDK runtime next to the exe (same as the MAUI variants); no framework package install needed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
</Project>
